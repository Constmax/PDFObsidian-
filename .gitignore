# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules
# The lockfile is pnpm-lock.yaml; `npm install` would add a second one
package-lock.json

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Anystyle input files
anystyle/

# Test vault fixture: keep its plugin settings, but never a build
!test-vault/.obsidian/plugins/pdf-plus/data.json
test-vault/.obsidian/plugins/pdf-plus/*.js
test-vault/.obsidian/plugins/pdf-plus/*.css

# macOS Finder duplicates ("file 2.ts")
* 2.*
